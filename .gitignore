# ===================================================================
# MINI-CEX (CodeIgniter 4) — .gitignore
# ===================================================================

# --------------- Sensitive credentials (DO NOT COMMIT) ---------------
config.php
smtp_config.php
config.local.php
auth.json

# -------------------------- Environment -----------------------------
.env
.env.*
!.env.example

# ----------------------- Composer dependencies ----------------------
vendor/

# ---------------------- CI4 writable directory ----------------------
# Cache, logs, sessions, uploads — all dynamically generated
writable/
uploads/

# --------------------------- Log files ------------------------------
*.log

# ------------------------- Build artifacts --------------------------
*.apk
*.ap_
*.dex
*.class

# ------------------------ Generated reports -------------------------
*.pdf
*.sql
*.sqlite
*.sqlite3
*.db
*.zip
*.rar
*.7z
*.tar
*.gz

# ------------------------- OS generated files ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------------------------- IDE / Editor --------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
*.sublime-workspace

# -------------------------- Scratch / temp -------------------------
scratch/
temp/
tmp/

# Project-local instructions and private server material
AGENTS.md
*.pem
*.key
*.p12
*.crt
*.cer
.htpasswd
